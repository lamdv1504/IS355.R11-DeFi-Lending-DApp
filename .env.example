# ==============================================================================
# DEFI LENDING DAPP - CẤU HÌNH MÔI TRƯỜNG MẪU (.env.example)
# Hướng dẫn: Copy file này thành `.env` và điền thông tin tương ứng.
# LƯU Ý BẢO MẬT:
# 1. TUYỆT ĐỐI KHÔNG commit file `.env` lên GitHub.
# 2. KHÔNG dùng Private Key của ví Hardhat Local trên mạng Sepolia hoặc Mainnet.
# 3. Backend Web3.py KHÔNG nhận hoặc lưu Private Key ví người dùng MetaMask.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CHẾ ĐỘ MẠNG ĐANG HOẠT ĐỘNG ("local" | "sepolia")
# ------------------------------------------------------------------------------
ACTIVE_NETWORK=local

# ------------------------------------------------------------------------------
# 2. MẠNG BLOCKCHAIN LOCAL (Hardhat Node cố định cho cả 4 thành viên)
# ------------------------------------------------------------------------------
LOCAL_RPC_URL=http://127.0.0.1:8545
LOCAL_CHAIN_ID=31337
LOCAL_MNEMONIC="test test test test test test test test test test test junk"
# Chỉ sử dụng cho bot hệ thống / script deploy_and_seed trên mạng LOCAL:
LOCAL_SYSTEM_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ------------------------------------------------------------------------------
# 3. MẠNG ETHEREUM SEPOLIA TESTNET (BẮT BUỘC THEO RUBRIC TIÊU CHÍ 1)
# Có thể dùng RPC từ Alchemy, Infura hoặc PublicNode:
# - Public RPC dự phòng: https://ethereum-sepolia-rpc.publicnode.com
# - Alchemy mẫu: https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
# - Infura mẫu: https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
# ------------------------------------------------------------------------------
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_CHAIN_ID=11155111
SEPOLIA_EXPLORER_URL=https://sepolia.etherscan.io
# Private key ví Testnet RIÊNG BIỆT (tạo ví mới chỉ chứa Sepolia ETH để deploy/smoke-test):
SEPOLIA_DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=

# ------------------------------------------------------------------------------
# 4. CẤU HÌNH BACKEND FASTAPI & BẢO MẬT (Q02, Q05)
# ------------------------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
# Generate a random secret of at least 32 bytes; keep it outside version control.
AUTH_TOKEN_SECRET=
AUTH_DOMAIN=localhost
AUTH_NONCE_TTL_SECONDS=300
AUTH_SESSION_TTL_SECONDS=3600
# Trusted server-side role mappings; comma-separated checksummed wallet addresses.
ADMIN_WALLETS=
LENDER_WALLETS=
# Khóa AES-256-GCM (64 ký tự hex = 32 bytes) để mã hóa hồ sơ IPFS riêng tư
# Sinh khóa ngẫu nhiên trước khi chạy: python -c "import secrets; print(secrets.token_hex(32))"
# KHÔNG dùng chuỗi mẫu cố định (như 0123456789abcdef...) khi chạy demo hoặc chụp bằng chứng bảo mật.
DOCUMENT_AES_KEY_HEX=

# ------------------------------------------------------------------------------
# 5. CẤU HÌNH IPFS KUBO LOCAL & PINATA CLOUD (H03, Q03, Q04)
# ------------------------------------------------------------------------------
IPFS_PROVIDER=local_fallback
IPFS_LOCAL_API_URL=http://127.0.0.1:5001
IPFS_LOCAL_GATEWAY_URL=http://127.0.0.1:8080/ipfs
PINATA_API_KEY=
PINATA_SECRET_API_KEY=
PINATA_JWT=
PINATA_GATEWAY_URL=https://gateway.pinata.cloud/ipfs

# ------------------------------------------------------------------------------
# 6. BÁO CÁO GAS HARDHAT (H04)
# ------------------------------------------------------------------------------
REPORT_GAS=false
